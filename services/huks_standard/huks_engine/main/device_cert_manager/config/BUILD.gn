import("//build/ohos.gni")

ohos_prebuilt_etc("huks_oem_dev_trusted_roots") {
  source = "rootcerts"
  part_name = "huks"
  subsystem_name = "security"
  relative_install_dir = "security/oemdevcertca"
  install_images = [
    "system",
    "updater",
  ]
}

ohos_prebuilt_etc("huks_oem_dev_subca_sninfo") {
  source = "subcasubjectinfos"
  part_name = "huks"
  subsystem_name = "security"
  relative_install_dir = "security/oemdevcertca"
  install_images = [
    "system",
    "updater",
  ]
}

group("huks_device_certificate_manager_trusted_roots") {
    deps = [
        ":huks_oem_dev_trusted_roots",
        ":huks_oem_dev_subca_sninfo",
    ]
}